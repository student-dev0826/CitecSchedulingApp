<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/chat_message_actions" android:textSize="18sp"
        android:textStyle="bold" android:textColor="@color/text_primary" />
    <TextView android:id="@+id/tvSelectedMessage" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="12dp"
        android:textSize="14sp" android:textColor="@color/text_secondary" android:maxLines="3" android:ellipsize="end" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnReplyMessage"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent" android:layout_height="56dp" android:gravity="start|center_vertical"
        android:text="@string/chat_reply" android:textColor="@color/text_primary" android:textSize="16sp"
        app:icon="@drawable/ic_reply" app:iconTint="@color/primary" app:iconPadding="20dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnCopyMessage"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent" android:layout_height="56dp" android:gravity="start|center_vertical"
        android:text="@string/chat_copy" android:textColor="@color/text_primary" android:textSize="16sp"
        app:icon="@drawable/ic_copy" app:iconTint="@color/primary" app:iconPadding="20dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnDeleteMessage"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent" android:layout_height="56dp" android:gravity="start|center_vertical"
        android:text="@string/chat_delete" android:textColor="#B91C1C" android:textSize="16sp"
        app:icon="@drawable/ic_delete" app:iconTint="#B91C1C" app:iconPadding="20dp" />
</LinearLayout>
