<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_light" android:fillViewport="true" android:clipToPadding="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CITEC SCHEDULING" android:textSize="13sp" android:textColor="@color/primary" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="University of Batangas Lipa City" android:textSize="12sp" android:textColor="@color/primary" android:layout_marginTop="4dp" android:textStyle="bold" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/primary" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="My Profile" android:textSize="28sp" android:textColor="@color/white" android:gravity="center" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Manage your account settings." android:textSize="14sp" android:textColor="@color/white" android:gravity="center" android:layout_marginTop="8dp" />
                <ImageView android:layout_width="88dp" android:layout_height="88dp" android:layout_gravity="center" android:layout_marginTop="24dp" android:layout_marginBottom="16dp" android:padding="22dp" android:background="@drawable/brand_yellow" android:src="@drawable/ic_profile" android:contentDescription="Profile" app:tint="@color/primary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="21sp" android:textColor="@color/white" android:gravity="center" android:textStyle="bold" android:id="@+id/tvProfileName" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="13sp" android:textColor="@color/white" android:gravity="center" android:layout_marginTop="6dp" android:id="@+id/tvProfileStudentId" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Account Details" android:textSize="23sp" android:textColor="@color/white" android:textStyle="bold" android:layout_marginTop="24dp" android:layout_marginBottom="14dp" />
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/bg_light" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp" android:layout_marginBottom="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Email Address" android:textSize="13sp" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="17sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginTop="4dp" android:id="@+id/tvProfileEmail" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/bg_light" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeWidth="0dp" android:layout_marginBottom="14dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="College / Department" android:textSize="13sp" android:textColor="@color/text_primary" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="College of Information Tech &amp; Computing (CITEC)" android:textSize="17sp" android:textColor="@color/text_primary" android:textStyle="bold" android:layout_marginTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnLogout" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/btn_logout" android:textColor="@color/brand_ink" android:textStyle="bold" android:textSize="16sp" android:textAllCaps="false" app:backgroundTint="@color/brand_yellow" app:cornerRadius="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>