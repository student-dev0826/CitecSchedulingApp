<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_light" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CITEC SCHEDULING" android:textSize="13sp" android:textColor="@color/primary" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="University of Batangas Lipa City" android:textSize="12sp" android:textColor="@color/primary" android:layout_marginTop="4dp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/brand_burgundy" android:padding="20dp" android:layout_marginBottom="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Book an appointment" android:textColor="@color/white" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Choose a date to see available times, professors and consultation categories." android:textColor="@color/brand_yellow" android:textSize="14sp" />
        </LinearLayout>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:hint="Search professor or department" app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp" app:boxStrokeColor="@color/primary" app:startIconDrawable="@drawable/ic_search" app:boxBackgroundColor="@color/bg_light">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etSearchProfessor" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/toggleModeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:checkedButton="@id/btnModePosted" app:selectionRequired="true" app:singleSelection="true" android:background="@drawable/brand_nav" android:padding="4dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnModePosted" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Available slots" android:textAllCaps="false" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0" app:backgroundTint="@color/role_fill" android:textColor="@color/role_text" app:strokeWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnModeCustom" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Custom request" android:textAllCaps="false" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0" app:backgroundTint="@color/role_fill" android:textColor="@color/role_text" app:strokeWidth="0dp" android:insetTop="0dp" android:insetBottom="0dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardPostedForm" android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/border_color" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBookingPreviousMonth" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:text="‹" android:textSize="22sp" android:contentDescription="Previous booking month" android:textAllCaps="false" android:letterSpacing="0" />
                    <TextView android:id="@+id/tvBookingMonth" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/primary" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnBookingNextMonth" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:text="›" android:textSize="22sp" android:contentDescription="Next booking month" android:textAllCaps="false" android:letterSpacing="0" />
                </LinearLayout>
                <TextView android:id="@+id/tvBookingMonthCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="14sp" android:textColor="@color/text_secondary" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:layout_marginBottom="8dp" android:text="Tap a highlighted date. Counts show available slots." android:textSize="12sp" android:textColor="@color/text_secondary" />
                <GridLayout android:id="@+id/gridBookingCalendar" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="7" />
                <TextView android:id="@+id/tvBookingCalendarStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:accessibilityLiveRegion="polite" android:textSize="13sp" android:textColor="@color/text_secondary" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnRefreshBookingSlots" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Refresh availability" android:textAllCaps="false" android:letterSpacing="0" />
                <TextView android:id="@+id/tvBookingSelectedDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" android:text="Choose a date to view its slots" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/primary" />
                <LinearLayout android:id="@+id/containerBookingDaySlots" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <LinearLayout android:id="@+id/containerSelectedBooking" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:id="@+id/tvSelectedBookingSlot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textSize="14sp" android:textColor="@color/primary" android:textStyle="bold" android:accessibilityLiveRegion="polite" />
                    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Purpose / Reason for Appointment" app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp" app:boxStrokeColor="@color/primary" app:boxBackgroundColor="@color/bg_light">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBookingReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top|start" android:inputType="textMultiLine" android:lines="3" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnSubmitBooking" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="Request selected slot" android:textAllCaps="false" android:textColor="@color/brand_ink" android:textSize="15sp" android:textStyle="bold" app:backgroundTint="@color/brand_yellow" app:cornerRadius="10dp" android:letterSpacing="0" app:iconTint="@color/brand_ink" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:id="@+id/cardCustomForm" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/border_color" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Target Professor / Faculty" app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp" app:boxStrokeColor="@color/primary" app:boxBackgroundColor="@color/bg_light">
                    <AutoCompleteTextView android:id="@+id/actCustomProfessor" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Requested Date (YYYY-MM-DD)" app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp" app:boxStrokeColor="@color/primary" app:endIconDrawable="@drawable/ic_schedule" app:endIconMode="custom" app:boxBackgroundColor="@color/bg_light">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCustomDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" android:clickable="true" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Requested Time Slot" app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp" app:boxStrokeColor="@color/primary" app:boxBackgroundColor="@color/bg_light">
                    <AutoCompleteTextView android:id="@+id/actCustomTimeSlot" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Category / Subject" app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp" app:boxStrokeColor="@color/primary" app:boxBackgroundColor="@color/bg_light">
                    <AutoCompleteTextView android:id="@+id/actCustomCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Purpose &amp; Additional Details" app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp" app:boxStrokeColor="@color/primary" app:boxBackgroundColor="@color/bg_light">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etCustomPurpose" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="top|start" android:inputType="textMultiLine" android:lines="3" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSubmitCustomRequest" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp" android:text="SEND APPOINTMENT REQUEST" android:textColor="@color/brand_ink" android:textSize="15sp" android:textStyle="bold" app:backgroundTint="@color/brand_yellow" app:cornerRadius="10dp" android:textAllCaps="false" android:letterSpacing="0" app:iconTint="@color/brand_ink" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>