<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg_light" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CITEC SCHEDULING" android:textSize="13sp" android:textColor="@color/primary" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="University of Batangas Lipa City" android:textSize="12sp" android:textColor="@color/primary" android:layout_marginTop="4dp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/brand_burgundy" android:padding="20dp" android:layout_marginBottom="20dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Post Available Schedules" android:textColor="@color/white" android:textSize="26sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Post consultation time slots for students to book" android:textColor="@color/brand_yellow" android:textSize="14sp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnWeeklyAvailability" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="16dp" android:text="Weekly schedules &amp; calendar" android:textAllCaps="false" android:letterSpacing="0" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/border_color" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="12dp" android:text="Create Schedule Slot" android:textColor="@color/primary_dark" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/tilPostDate" android:hint="Schedule Date" app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp" app:boxStrokeColor="@color/primary" app:endIconDrawable="@drawable/ic_schedule" app:endIconMode="custom" app:boxBackgroundColor="@color/bg_light" app:placeholderText="Tap to choose a date">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPostDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:cursorVisible="false" android:focusable="false" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Time Slot Range" app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp" app:boxStrokeColor="@color/primary" app:boxBackgroundColor="@color/bg_light" app:placeholderText="Select time slot">
                    <AutoCompleteTextView android:id="@+id/actPostTimeSlot" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Consultation Type" app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp" app:boxStrokeColor="@color/primary" app:boxBackgroundColor="@color/bg_light" app:placeholderText="Select category">
                    <AutoCompleteTextView android:id="@+id/actPostCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Office / Room Location" app:boxCornerRadiusBottomEnd="10dp" app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusTopEnd="10dp" app:boxCornerRadiusTopStart="10dp" app:boxStrokeColor="@color/primary" app:boxBackgroundColor="@color/bg_light" app:placeholderText="e.g. CITEC Building, Room 204">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/etPostLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPostSchedule" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="20dp" android:text="POST AVAILABLE SCHEDULE" android:textColor="@color/brand_ink" android:textSize="14sp" android:textStyle="bold" app:backgroundTint="@color/brand_yellow" app:cornerRadius="10dp" android:textAllCaps="false" android:letterSpacing="0" app:iconTint="@color/brand_ink" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:layout_marginBottom="12dp" android:text="My Posted Available Schedules" android:textColor="@color/primary_dark" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvNoPostedSchedules" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="20dp" android:text="No consultation schedules posted yet. Use the form above to post available slots for students." android:textColor="@color/text_secondary" android:textSize="14sp" />
        <LinearLayout android:id="@+id/containerPostedSchedules" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
</ScrollView>